# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.

# Leaguepedia es la fuente principal de datos cuando estas credenciales existen
# (si falla, se usa Oracle's Elixir en Google Drive). Sin iniciar sesión, Leaguepedia permite
# ~1 consulta por minuto, así que hace falta una contraseña de bot gratuita:
# https://lol.fandom.com/wiki/Special:BotPasswords
LEAGUEPEDIA_BOT_USER=TuUsuario@synergies
LEAGUEPEDIA_BOT_PASSWORD=
